# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Ollama (IA local) ────────────────────────────────────
# Solo lo usa apps/server (el cerebro unificado)
OLLAMA_URL=http://localhost:11434
# Default del repo: tinyllama (packages/shared). Override opcional:
# OLLAMA_MODEL=llama3

# Prompt opcional del sistema para el asistente
# SYSTEM_PROMPT=You are Lobster, a helpful AI assistant.

# ─── Rate limiting / API interna ──────────────────────────
# Clave para peticiones internas bot→server (header x-internal-key)
INTERNAL_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ─── OAuth (opcional) ─────────────────────────────────────
# Deja en blanco para usar sesiones anónimas
OAUTH_PORTAL_URL=
APP_ID=
APP_SECRET=

# ─── Bots ─────────────────────────────────────────────────
# Los bots hablan con el server local (cerebro unificado).
# Requieren apps/server corriendo: pnpm dev:server
LOBSTER_SERVER_URL=http://127.0.0.1:3000
TELEGRAM_TOKEN=
DISCORD_TOKEN=
SLACK_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ENABLED=false

# ─── Cliente (Vite) ───────────────────────────────────────
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# ─── Agent (camino B: control de PC) ─────────────────────
# Cerebro: con OPENROUTER_API_KEY se usa OpenRouter (p. ej. dolphin-mistral-24b
# venice edition:free, uncensored por API); sin key se usa Ollama local.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# (gratis y con tools vía JSON; alternativas: nvidia/nemotron-3.5-lightning:free
#  más rápido, nvidia/nemotron-3.5-super-vl:free con visión, o el pago
#  cognitivecomputations/dolphin-mistral-24b-venice-edition — sin variante free)
# AGENT_MODEL=llama3.2:1b
# AGENT_NUM_PREDICT=300
# AGENT_MAX_STEPS=6
# Vision (look/screenshot envian la captura a OpenRouter):
# AGENT_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# Actuadores fisicos (click/type_text): por defecto solo vista previa. Para ejecutar de verdad:
# AGENT_ALLOW_CLICKS=1
