# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Ollama (IA local) ────────────────────────────────────
# Solo lo usa apps/server (el cerebro unificado)
OLLAMA_URL=http://localhost:11434
# Default del repo: tinyllama (packages/shared). Override opcional:
# OLLAMA_MODEL=llama3

# Prompt opcional del sistema para el asistente
# SYSTEM_PROMPT=You are Lobster, a helpful AI assistant.

# ─── Rate limiting / API interna ──────────────────────────
# Clave para peticiones internas bot→server (header x-internal-key)
INTERNAL_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ─── OAuth (opcional) ─────────────────────────────────────
# Deja en blanco para usar sesiones anónimas
OAUTH_PORTAL_URL=
APP_ID=
APP_SECRET=

# ─── Bots ─────────────────────────────────────────────────
# Los bots hablan con el server local (cerebro unificado).
# Requieren apps/server corriendo: pnpm dev:server
LOBSTER_SERVER_URL=http://127.0.0.1:3000
TELEGRAM_TOKEN=
DISCORD_TOKEN=
SLACK_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ENABLED=false

# ─── Cliente (Vite) ───────────────────────────────────────
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
