# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Ollama (IA local) ────────────────────────────────────
# El server usa OLLAMA_MODEL; el bot usa MODEL
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Prompt opcional del sistema para el asistente
# SYSTEM_PROMPT=You are Lobster, a helpful AI assistant.

# ─── Rate limiting / API interna ──────────────────────────
# Clave para peticiones internas bot→server (header x-internal-key)
INTERNAL_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ─── OAuth (opcional) ─────────────────────────────────────
# Deja en blanco para usar sesiones anónimas
OAUTH_PORTAL_URL=
APP_ID=
APP_SECRET=

# ─── Bots ─────────────────────────────────────────────────
TELEGRAM_TOKEN=
DISCORD_TOKEN=
SLACK_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ENABLED=false
# Modelo de Ollama que usa el bot
MODEL=tinyllama

# ─── Cliente (Vite) ───────────────────────────────────────
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
