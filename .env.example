# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── Ollama (IA local) ────────────────────────────────────
# Solo lo usa apps/server (el cerebro unificado)
OLLAMA_URL=http://localhost:11434
# Default del repo: tinyllama (packages/shared). Override opcional:
# OLLAMA_MODEL=llama3

# Prompt opcional del sistema para el asistente
# SYSTEM_PROMPT=You are Lobster, a helpful AI assistant.

# ─── Rate limiting / API interna ──────────────────────────
# Clave para peticiones internas bot→server (header x-internal-key)
INTERNAL_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ─── OAuth (opcional) ─────────────────────────────────────
# Deja en blanco para usar sesiones anónimas
OAUTH_PORTAL_URL=
APP_ID=
APP_SECRET=

# ─── Bots ─────────────────────────────────────────────────
# Los bots hablan con el server local (cerebro unificado).
# Requieren apps/server corriendo: pnpm dev:server
LOBSTER_SERVER_URL=http://127.0.0.1:3000
TELEGRAM_TOKEN=
DISCORD_TOKEN=
SLACK_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ENABLED=false

# ─── Cliente (Vite) ───────────────────────────────────────
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# ─── Proveedor LLM (protocolo OpenAI; elegi UNO) ──────────
# OpenRouter (gratis limitado ~50 req/dia):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#
# Google AI Studio / Gemini (GRATIS sin tarjeta, ~1500 req/dia y vision):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_VISION_MODEL=gemini-3.1-flash-lite
# (gemini-2.5-flash quedo retirado para usuarios nuevos en 2026-11; alternativa premium: gemini-3-flash-preview)
#
# Groq (GRATIS, muy rapido):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# Cerebras (gratis): LLM_BASE_URL=https://api.cerebras.ai/v1 · LLM_MODEL=llama-3.3-70b
# Cloudflare Workers AI: https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1 · @cf/meta/llama-3.1-8b-instruct
#
# Si la nube falla, el agente cae solo a Ollama local (pon 0 para desactivar):
# AGENT_LOCAL_FALLBACK=1
# AGENT_MODEL=llama3.2:1b
# AGENT_NUM_PREDICT=300
# AGENT_MAX_STEPS=8
# Actuadores fisicos (click/type_text): por defecto solo vista previa.
# AGENT_ALLOW_CLICKS=1
