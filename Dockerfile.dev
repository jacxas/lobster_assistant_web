# Development image — installs workspace deps only; source is bind-mounted at runtime
FROM node:20-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# better-sqlite3 ships no musl prebuild, so it compiles from source on alpine
RUN apk add --no-cache python3 make g++

# Copy workspace manifests so pnpm can resolve the workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY apps/server/package.json ./apps/server/
COPY apps/bot/package.json ./apps/bot/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile
